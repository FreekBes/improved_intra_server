# Flask configs
MAX_CONTENT_LENGTH=10485760 # 10MB, also needs to be changed in nginx snippet
SQLALCHEMY_TRACK_MODIFICATIONS=false

# PostgreSQL configs (user, password and database live in .private.env,
# because the database container reads them from there too)
# The database service name in docker-compose.yml. Override in
# .private.env if yours is called something else.
POSTGRES_HOST="iintra_database"
POSTGRES_PORT=5432

# Log configs
LOG_FORMAT="%(asctime)s %(message)s"
LOG_FILE_SERVER="./logs/server.log"

# API configs
INTRA_API_URL="https://api.intra.42.fr/v2/"
INTRA_AUTH_URL="https://api.intra.42.fr/oauth/authorize"
INTRA_TOKEN_URL="https://api.intra.42.fr/oauth/token"

# Improved Intra settings
IINTRA_URL="https://iintra.freekb.es/"
