# Copy this file to .private.env and fill in the values before running
# docker compose. Non-secret defaults live in .public.env, which is committed
# and baked into the image.

# PostgreSQL. The application and the database container read the same names,
# so each value is only written once.
POSTGRES_USER="postgres"
POSTGRES_PASSWORD="postgres"
POSTGRES_DB="iintra"

# Intra API client for back-end stuff
BE_CLIENT_ID="your_intra_app_id"
BE_CLIENT_SECRET="your_intra_app_secret"

# Intra API client for OAuth2
O2_CLIENT_ID="your_intra_app_id"
O2_CLIENT_SECRET="your_intra_app_secret"

# Flask
SESSION_KEY="any_random_string"

# Custom session tokens
TOKEN_SECRET="any_random_string"
# Optional, in seconds. Defaults to 30 days when unset.
#TOKEN_EXPIRATION=2592000
