<!DOCTYPE html>
<html>
	<head>
		<meta charset='utf-8' />
		<title>Improved Intra 42 banners</title>
		<link rel="shortcut icon" href="{{ url_for('static', filename='favicon.ico') }}" type="image/x-icon" />
		<link rel="icon" type="image/ico" href="{{ url_for('static', filename='favicon.ico') }}" />
		<meta name="viewport" content="width=device-width, initial-scale=1">
		<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@4.3.1/dist/css/bootstrap.min.css" integrity="sha384-ggOyR0iXCbMQv3Xipma34MD+dH/1fQ784/j6cY/iJTQUOhcWr7x9JvoRxT2MZw1T" crossorigin="anonymous">
		<style>
			#banners-table {
				table-layout: fixed;
			}

			#banners-table td, #banners-table th {
				vertical-align: middle;
			}

			#banners-table td:first-child {
				width: 100px;
			}

			.banner-img {
				display: block;
				max-height: 125px;
				max-width: 100%;
				cursor: zoom-in;
			}

			.img-col {
				width: 50%;
			}

			tbody .img-col {
				height: 125px;
			}
		</style>
	</head>
	<body class="bg-dark text-white">
		<template id="banner-template">
			<tr class="banner-row">
				<th scope="row">0.</th>
				<td><a href="https://profile.intra.42.fr/users/me" target="_blank">login</a></td>
				<td>campus</td>
				<td>date</td>
				<td>domain</td>
				<td class="img-col" ><img class="banner-img" loading="lazy" src="data:image/gif;base64,R0lGODlhAQABAAAAACH5BAEKAAEALAAAAAABAAEAAAICTAEAOw==" alt="Could not load image" onclick="window.open(this.src);" /></td>
			</tr>
		</template>
		<h1>Banners uploaded by Improved Intra users</h1>
		<form id="banner-filters" class="form-row align-items-end mx-0 mb-3">
			<div class="col-sm-4 col-lg-3 mb-2">
				<label for="campus-filter">Campus</label>
				<select id="campus-filter" name="campus_id" class="form-control">
					<option value="">All campuses</option>
					{% for campus in campuses %}
					<option value="{{ campus.intra_id }}">{{ campus.name }}</option>
					{% endfor %}
				</select>
			</div>
			<div class="col-sm-4 col-lg-3 mb-2">
				<label for="login-filter">Uploader login</label>
				<input id="login-filter" name="login" type="search" class="form-control" placeholder="Search by login" />
			</div>
			<div class="col-auto mb-2">
				<button type="submit" class="btn btn-light">Apply filters</button>
				<button type="button" id="clear-filters" class="btn btn-outline-light">Clear</button>
			</div>
		</form>
		<p id="banner-status" role="status" aria-live="polite"></p>
		<table class="table table-striped table-dark" id="banners-table">
			<thead>
				<tr>
					<th scope="col">ID</th>
					<th scope="col">User</th>
					<th scope="col">Campus</th>
					<th scope="col">Upload date</th>
					<th scope="col">Domain</th>
					<th class="img-col" scope="col">Image</th>
				</tr>
			</thead>
			<tbody></tbody>
		</table>
		<button id="load-more" type="button" class="btn btn-outline-light mb-3">Load more</button>
		<script>
			let hasMoreBanners = true;
			let req = null;
			let offset = 0;
			let filters = new URLSearchParams();
			const pageSize = 100;
			const form = document.getElementById('banner-filters');
			const tableBody = document.querySelector('#banners-table tbody');
			const status = document.getElementById('banner-status');
			const loadMore = document.getElementById('load-more');

			function getMoreBanners() {
				if (!hasMoreBanners || req) return;
				status.textContent = 'Loading banners…';
				loadMore.disabled = true;
				req = new XMLHttpRequest();
				req.addEventListener('load', function() {
					if (this !== req) return;
					req = null;
					loadMore.disabled = false;
					try {
						if (this.status !== 200 && this.status !== 204) throw new Error('Request failed');
						const banners = this.status === 204 ? [] : JSON.parse(this.responseText).data;
						const rows = document.createDocumentFragment();
						for (const banner of banners) {
							const row = document.getElementById('banner-template').content.cloneNode(true);
							const cols = row.firstElementChild.children;
							cols[0].textContent = banner.id + '.';
							const userLink = cols[1].firstElementChild;
							userLink.textContent = (banner.user.login || 'Unknown') + (banner.user.staff ? ' (staff)' : '');
							if (banner.user.login) {
								userLink.href = 'https://profile.intra.42.fr/users/' + encodeURIComponent(banner.user.login);
							} else {
								userLink.removeAttribute('href');
							}
							cols[2].textContent = banner.user.campus || 'Unknown';
							cols[3].textContent = banner.created_at.split(' ')[0];
							cols[4].textContent = new URL(banner.url).hostname;
							cols[5].firstElementChild.src = banner.url;
							cols[5].firstElementChild.title = banner.url;
							rows.appendChild(row);
						}
						tableBody.appendChild(rows);
						offset += banners.length;
						hasMoreBanners = banners.length === pageSize;
						loadMore.hidden = !hasMoreBanners;
						status.textContent = offset ? offset + ' banners shown' : 'No banners match these filters.';
					} catch (err) {
						status.textContent = 'Could not load banners. Use Load more to retry.';
					}
				});
				req.addEventListener('error', function() {
					if (this !== req) return;
					req = null;
					loadMore.disabled = false;
					status.textContent = 'Could not load banners. Use Load more to retry.';
				});
				req.open('GET', "{{ url_for('bannersoffset', offset='replace') }}".replace('replace', offset) + '?' + filters);
				req.send();
			}

			function applyFilters() {
				if (req) req.abort();
				req = null;
				filters = new URLSearchParams(new FormData(form));
				offset = 0;
				hasMoreBanners = true;
				tableBody.replaceChildren();
				loadMore.hidden = false;
				getMoreBanners();
			}

			form.addEventListener('submit', function(event) {
				event.preventDefault();
				applyFilters();
			});
			document.getElementById('clear-filters').addEventListener('click', function() {
				form.reset();
				applyFilters();
			});
			loadMore.addEventListener('click', getMoreBanners);
			window.addEventListener('scroll', function() {
				const { scrollTop, scrollHeight, clientHeight } = document.documentElement;
				if (scrollTop + clientHeight >= scrollHeight - 1250) getMoreBanners();
			}, { passive: true });
			getMoreBanners();
		</script>
	</body>
</html>
